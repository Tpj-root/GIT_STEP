# Copy to .env. NEVER commit .env — it holds broker credentials.

# --- market data (no credentials needed) ---------------------------------
DERIV_APP_ID=1089
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# --- execution -----------------------------------------------------------
# paper | mt5 | deriv        paper is the default and needs nothing else
BROKER=paper

# --- Deriv contract trading (BROKER=deriv) -------------------------------
# Create at: app.deriv.com  →  Settings → API token
#   * scopes required: read AND trade
#   * create it while your DEMO (VRTC…) account is selected
#   * format is ~15 alphanumeric characters, NO prefix  e.g. a1b2C3d4E5f6G7h
#     A long "pat_…" style token is from some other service and Deriv will
#     reject it with InvalidToken.
# Verify before trading:  python backend/doctor.py
DERIV_API_TOKEN=

# Contracts are priced in STAKE, not lots. Deriv's API cannot place MT5 orders.
DERIV_CONTRACT_TYPE=MULT
DERIV_MULTIPLIER=100

# --- MT5 bridge (BROKER=mt5, Windows only, terminal must be running) -----
# MT5_LOGIN=12345678
# MT5_PASSWORD=
# MT5_SERVER=Deriv-Demo

# --- server-side hard caps (the UI can never exceed these) ---------------
HARD_MAX_LOTS=1.0
HARD_MAX_DAILY_LOSS=1000.0
STALE_TICK_SECONDS=10
COUNTER_RESET_UTC_HOUR=0

DB_PATH=trading.db
